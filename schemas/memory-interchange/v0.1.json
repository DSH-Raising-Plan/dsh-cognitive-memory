{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemosyne.local/schemas/memory-interchange/v0.1.json",
  "title": "Memory Interchange Model Bundle",
  "description": "Provider-agnostic memory exchange envelope. Design-frozen 0.1 — not part of foundation-0.1.0. Separate from Component Contract and UDM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mim_version", "bundle_id", "exported_at", "source", "items"],
  "properties": {
    "mim_version": {
      "type": "string",
      "const": "0.1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "instance": { "type": "string" },
        "export_tool": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/MemoryItem" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/RelationItem" }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "Provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string" },
        "raw_ref": { "type": "string" },
        "trust_hint": {
          "type": "string",
          "enum": ["untrusted", "user_asserted", "verified"]
        },
        "notes": { "type": "string" }
      }
    },
    "MemoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_id", "content", "kind", "provenance"],
      "properties": {
        "external_id": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["note", "message", "fact", "episode", "other"]
        },
        "event_time": { "type": "string", "format": "date-time" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "identity_keys": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "payload": {},
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "RelationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_external_id", "to_external_id", "relation"],
      "properties": {
        "from_external_id": { "type": "string" },
        "to_external_id": { "type": "string" },
        "relation": { "type": "string" },
        "provenance": { "$ref": "#/$defs/Provenance" }
      }
    }
  }
}
